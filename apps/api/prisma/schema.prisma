generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum RefType {
  OEM
  COMPETITOR
  SUPERSEDES
  ALTERNATE
}

enum StockTransactionType {
  SALE
  PURCHASE
  ADJUSTMENT
}

model Manufacturer {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parts Part[]

  @@map("manufacturer")
}

model Category {
  id               Int      @id @default(autoincrement())
  name             String
  parentCategoryId Int?     @map("parent_category_id")
  displayOrder     Int      @default(0) @map("display_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  parts    Part[]

  @@index([parentCategoryId])
  @@map("category")
}

model PartGrade {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parts Part[]

  @@map("part_grade")
}

model Part {
  id                     Int      @id @default(autoincrement())
  sku                    String   @unique
  skuNormalized          String   @map("sku_normalized")
  manufacturerId         Int      @map("manufacturer_id")
  manufacturerPartNumber String   @map("manufacturer_part_number")
  mpnNormalized          String   @map("mpn_normalized")
  name                   String
  description            String?
  categoryId             Int      @map("category_id")
  gradeId                Int?     @map("grade_id")
  copyOfPartId           Int?     @map("copy_of_part_id")
  unitOfMeasure          String   @default("piece") @map("unit_of_measure")
  mrp                    Decimal? @db.Decimal(10, 2)
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  manufacturer    Manufacturer         @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  category        Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  grade           PartGrade?           @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  // NOTE: Copy families are flat (one level): a part with copyOfPartId set can
  // never itself be a link target, and a part that has copies can never gain a
  // copyOfPartId. Must be enforced at the service layer (services/partFamily.ts)
  // — a CHECK cannot see other rows and this repo has no triggers; direct DB
  // writes (e.g. seed) must respect it manually.
  copyOf          Part?                @relation("PartCopyLink", fields: [copyOfPartId], references: [id], onDelete: Restrict)
  copies          Part[]               @relation("PartCopyLink")
  fitments        PartFitment[]
  crossReferences PartCrossReference[]
  supplierParts   SupplierPart[]
  inventoryItems  InventoryItem[]
  transactions    StockTransaction[]
  invoiceLines    InvoiceLine[]

  @@unique([manufacturerId, manufacturerPartNumber])
  @@index([skuNormalized])
  @@index([mpnNormalized])
  @@index([categoryId])
  @@index([gradeId])
  @@index([copyOfPartId])
  @@map("part")
}

model PartCrossReference {
  id                  Int      @id @default(autoincrement())
  partId              Int      @map("part_id")
  refType             RefType  @map("ref_type")
  refNumber           String   @map("ref_number")
  refNumberNormalized String   @map("ref_number_normalized")
  refBrand            String?  @map("ref_brand")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([refNumberNormalized])
  @@index([partId])
  @@map("part_cross_reference")
}

model VehicleClass {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  models   VehicleModel[]
  fitments PartFitment[]

  @@map("vehicle_class")
}

model VehicleMake {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  models   VehicleModel[]
  fitments PartFitment[]

  @@map("vehicle_make")
}

model VehicleModel {
  id             Int      @id @default(autoincrement())
  vehicleMakeId  Int      @map("vehicle_make_id")
  vehicleClassId Int      @map("vehicle_class_id")
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  vehicleMake  VehicleMake   @relation(fields: [vehicleMakeId], references: [id], onDelete: Restrict)
  vehicleClass VehicleClass  @relation(fields: [vehicleClassId], references: [id], onDelete: Restrict)
  fitments     PartFitment[]

  @@unique([vehicleMakeId, vehicleClassId, name])
  @@index([vehicleClassId])
  @@map("vehicle_model")
}

model PartFitment {
  id             Int     @id @default(autoincrement())
  partId         Int     @map("part_id")
  vehicleClassId Int     @map("vehicle_class_id")
  vehicleMakeId  Int?    @map("vehicle_make_id")
  vehicleModelId Int?    @map("vehicle_model_id")
  notes          String?

  part         Part          @relation(fields: [partId], references: [id], onDelete: Cascade)
  vehicleClass VehicleClass  @relation(fields: [vehicleClassId], references: [id], onDelete: Restrict)
  vehicleMake  VehicleMake?  @relation(fields: [vehicleMakeId], references: [id], onDelete: Restrict)
  vehicleModel VehicleModel? @relation(fields: [vehicleModelId], references: [id], onDelete: Restrict)

  // NOTE: Postgres treats NULLs as distinct, so this @@unique alone cannot
  // prevent duplicate class-level or make-level fitment rows. Real dedup is
  // enforced by three partial unique indexes added via raw SQL in the init
  // migration (one per specificity rung). This @@unique stays for Prisma's
  // typed unique queries on fully-specified rows.
  // Review generated migrations: these three partial indexes must never be dropped.
  @@unique([partId, vehicleClassId, vehicleMakeId, vehicleModelId])
  @@index([vehicleClassId, vehicleMakeId, vehicleModelId])
  @@map("part_fitment")
}

model Supplier {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  address       String?
  gstin         String?
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  supplierParts SupplierPart[]

  @@map("supplier")
}

model SupplierPart {
  id                           Int      @id @default(autoincrement())
  supplierId                   Int      @map("supplier_id")
  partId                       Int      @map("part_id")
  supplierPartNumber           String?  @map("supplier_part_number")
  supplierPartNumberNormalized String?  @map("supplier_part_number_normalized")
  isPreferred                  Boolean  @default(false) @map("is_preferred")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  part     Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([supplierId, partId])
  @@index([supplierPartNumberNormalized])
  @@index([partId])
  @@map("supplier_part")
}

model Shop {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  gstin     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           User[]
  inventoryItems  InventoryItem[]
  transactions    StockTransaction[]
  invoices        Invoice[]
  invoiceSequence InvoiceSequence?

  @@map("shop")
}

model User {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  name         String
  phone        String?
  // Contact detail only. Any OWNER can set this to an arbitrary string via
  // POST/PATCH /shops/:shopId/users, so it is NOT proof that the user owns the address
  // and must never be used to match an incoming social identity.
  email        String?
  // Written only by a provider-verified OAuth sign-in — never from request input — so
  // matching on it is safe. Unique so an identity links to exactly one account; NULLs
  // stay distinct in Postgres, leaving PIN-only users unaffected.
  verifiedEmail String? @unique @map("verified_email")
  username     String?  @unique
  passwordHash String?  @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shop         Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  transactions StockTransaction[]
  invoices     Invoice[]
  identities   UserIdentity[]

  @@index([shopId])
  @@map("app_user")
}

// One row per external account (Google, …) linked to a user. Kept separate from User
// so one person can attach several providers, and so a social-only account needs no
// username/passwordHash at all — both columns are already nullable.
model UserIdentity {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  provider       String
  providerUserId String   @map("provider_user_id")
  email          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_identity")
}

model InventoryItem {
  id              Int      @id @default(autoincrement())
  shopId          Int      @map("shop_id")
  partId          Int      @map("part_id")
  quantityOnHand  Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(10, 3)
  reorderLevel    Decimal? @map("reorder_level") @db.Decimal(10, 3)
  costPrice       Decimal? @map("cost_price") @db.Decimal(10, 2)
  sellingPrice    Decimal? @map("selling_price") @db.Decimal(10, 2)
  storageLocation String?  @map("storage_location")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  part Part @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([shopId, partId])
  @@index([partId])
  @@map("inventory_item")
}

model StockTransaction {
  id        Int                  @id @default(autoincrement())
  shopId    Int                  @map("shop_id")
  partId    Int                  @map("part_id")
  userId    Int                  @map("user_id")
  type      StockTransactionType
  quantity  Decimal              @db.Decimal(10, 3)
  unitPrice Decimal?             @map("unit_price") @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime             @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  part Part @relation(fields: [partId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  invoiceLine InvoiceLine?

  @@index([shopId, partId, createdAt])
  @@index([shopId, type, createdAt])
  @@index([userId])
  @@map("stock_transaction")
}

model Invoice {
  id            Int      @id @default(autoincrement())
  shopId        Int      @map("shop_id")
  userId        Int      @map("user_id")
  invoiceNumber String   @map("invoice_number")
  customerName  String?  @map("customer_name")
  customerPhone String?  @map("customer_phone")
  notes         String?
  total         Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  shop  Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  lines InvoiceLine[]

  @@unique([shopId, invoiceNumber])
  @@index([shopId, createdAt])
  @@map("invoice")
}

model InvoiceLine {
  id                 Int     @id @default(autoincrement())
  invoiceId          Int     @map("invoice_id")
  partId             Int     @map("part_id")
  stockTransactionId Int     @unique @map("stock_transaction_id")
  partSku            String  @map("part_sku")
  partName           String  @map("part_name")
  quantity           Decimal @db.Decimal(10, 3)
  unitPrice          Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal          Decimal @map("line_total") @db.Decimal(10, 2)

  invoice          Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  part             Part             @relation(fields: [partId], references: [id], onDelete: Restrict)
  stockTransaction StockTransaction @relation(fields: [stockTransactionId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([partId])
  @@map("invoice_line")
}

model InvoiceSequence {
  shopId    Int      @id @map("shop_id")
  lastSeq   Int      @default(0) @map("last_seq")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("invoice_sequence")
}
