DATABASE_URL=postgresql://shop:shop@localhost:5433/shop_management
PORT=4000
# For any deployed/shared instance generate a strong value: openssl rand -hex 32
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=12h
ALLOWED_ORIGINS=http://localhost:3000
# In a deployment, set this to the web app's OWN origin so browser calls go through its
# same-origin /api/v1 proxy (API_PROXY_TARGET = the API origin). See docs/deploy-railway.md.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where the API sends the browser after a social sign-in, and the origin the OAuth
# redirect URI is built from. Must be the public web origin in a deployment; with any
# OAuth provider enabled, the API refuses to boot in production when it is unset.
WEB_APP_URL=http://localhost:3000

# Social sign-in (OAuth 2.0 + OIDC). Both values must be set for a provider to appear
# on the sign-in screen — leave them unset and the app is username + PIN only.
# Create the client at https://console.cloud.google.com/apis/credentials and register
# <WEB_APP_URL>/api/v1/auth/oauth/google/callback as an Authorized redirect URI.
# See docs/oauth-setup.md for the full walkthrough.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional override for the redirect URI base. Must stay on the WEB_APP_URL origin: the
# sign-in transaction cookie is set there, and the API refuses to boot in production
# if the origins differ.
# OAUTH_REDIRECT_BASE_URL=

# First-owner bootstrap — used by `pnpm --filter api bootstrap:owner` (e.g. on Railway),
# which creates one shop + one OWNER on a fresh database. Local dev uses `db:seed`
# instead, so these are optional locally.
# BOOTSTRAP_OWNER_USERNAME=owner
# BOOTSTRAP_OWNER_PIN=1234
# BOOTSTRAP_OWNER_NAME=Shop Owner
# BOOTSTRAP_SHOP_NAME=My Shop
